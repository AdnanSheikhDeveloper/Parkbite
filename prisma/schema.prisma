datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  category    Category
  costPrice   Decimal
  sellPrice   Decimal
  isAvailable Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  orderItems  OrderItem[]
}

enum Category {
  SNACKS
  BEVERAGES
  QUICK_MEALS
  CHINESE
  CUSTOM
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  company   String?
  floor     String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id              String        @id @default(cuid())
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  deliveryWindow  DeliveryWindow
  status          OrderStatus   @default(PLACED)
  totalAmount     Decimal
  paymentMethod   PaymentMethod @default(UPI_QR)
  paymentStatus   PaymentStatus @default(PENDING)
  upiReferenceNo  String?
  paidAt          DateTime?
  paidBy          String?       // "rider", "admin", or "customer-reported"
  customRequest   String?
  items           OrderItem[]
  feedback        Feedback?
  createdAt       DateTime      @default(now())
  statusUpdatedAt DateTime      @default(now()) @updatedAt
}

enum DeliveryWindow {
  MORNING_11AM
  AFTERNOON_4PM
}

enum OrderStatus {
  PLACED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI_QR
}

enum PaymentStatus {
  PENDING
  PAID
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  quantity     Int
  priceAtOrder Decimal
}

model Feedback {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
}

